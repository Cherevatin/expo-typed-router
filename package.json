{
  "name": "expo-typed-router",
  "version": "0.1.0",
  "description": "Config-driven typed navigation and parameter parsing for Expo Router",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "expo-router": ">=57.0.0 <58",
    "react": ">=19.0.0 <20",
    "react-native": ">=0.83.0 <1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "expo",
    "expo-router",
    "react-native",
    "typescript",
    "navigation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
