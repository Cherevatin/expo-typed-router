{
  "name": "typed-expo-router",
  "version": "0.1.0",
  "description": "Config-driven typed navigation and parameter parsing for Expo Router",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && jest --runInBand",
    "test:types": "tsc -p tests/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "expo-router": ">=57.0.0 <58",
    "react": ">=19.0.0 <20",
    "react-native": ">=0.83.0 <1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^57.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": ["babel-preset-expo"]
        }
      ]
    }
  },
  "keywords": [
    "expo",
    "expo-router",
    "react-native",
    "typescript",
    "navigation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cherevatin/typed-expo-router.git"
  },
  "homepage": "https://github.com/Cherevatin/typed-expo-router#readme",
  "bugs": {
    "url": "https://github.com/Cherevatin/typed-expo-router/issues"
  }
}
